{% macro symbol(name) %}
    <svg class="icon icon-{{ name }}" viewBox="0 0 24 24" aria-hidden="true">
        {% if name == 'clear-day' or name == 'uv' %}
            <circle cx="12" cy="12" r="4"></circle>
            <path d="M12 2.4v2.2M12 19.4v2.2M2.4 12h2.2M19.4 12h2.2M4.9 4.9l1.6 1.6M17.5 17.5l1.6 1.6M19.1 4.9l-1.6 1.6M6.5 17.5L4.9 19.1"></path>
        {% elseif name == 'clear-night' or name == 'moon' %}
            <path d="M15.2 3.4a7.4 7.4 0 1 0 5.2 12.7A6.6 6.6 0 0 1 15.2 3.4z"></path>
        {% elseif name == 'partly-day' %}
            <circle cx="7.2" cy="7.2" r="2.4"></circle>
            <path d="M7.2 2.3v1.5M7.2 10.6v1.5M2.3 7.2h1.5M10.6 7.2h1.5M8.8 18.6h8a3 3 0 0 0 .3-6 3.8 3.8 0 0 0-7.3-.8 2.7 2.7 0 0 0-1 6.8z"></path>
        {% elseif name == 'partly-night' %}
            <path d="M8.2 3.2a4.2 4.2 0 0 0 3.4 6.6M9.2 18.6h8a3 3 0 0 0 .2-6 3.8 3.8 0 0 0-7.2-1 2.7 2.7 0 0 0-1 7z"></path>
        {% elseif name == 'cloudy' or name == 'overcast' %}
            <path d="M7 18h10.2a3.8 3.8 0 0 0 .4-7.6 5 5 0 0 0-9.6-1.3A3.4 3.4 0 0 0 7 18z"></path>
        {% elseif name == 'fog' %}
            <path d="M4 8.5h16M3 12h18M5 15.5h14"></path>
        {% elseif name == 'drizzle' %}
            <path d="M7 14.5h9.2a3.3 3.3 0 0 0 .3-6.6 4.3 4.3 0 0 0-8.3-1.1A3 3 0 0 0 7 14.5zM8.5 17.2v1.6M12 17.8v1.6M15.5 17.2v1.6"></path>
        {% elseif name == 'rain' %}
            <path d="M7 13.5h9.5a3.4 3.4 0 0 0 .3-6.8 4.4 4.4 0 0 0-8.5-1.1A3 3 0 0 0 7 13.5zM8 16.2l-1 3M12 16.6l-1 3M16 16.2l-1 3"></path>
        {% elseif name == 'snow' %}
            <path d="M7 13h9.5a3.4 3.4 0 0 0 .3-6.8 4.4 4.4 0 0 0-8.5-1.1A3 3 0 0 0 7 13zM8.5 16.5v.2M12 17.6v.2M15.5 16.5v.2M8.5 19.4v.2M12 20.4v.2M15.5 19.4v.2"></path>
        {% elseif name == 'thunder' %}
            <path d="M7 13h9.2a3.3 3.3 0 0 0 .3-6.6 4.3 4.3 0 0 0-8.3-1A3 3 0 0 0 7 13zM13 14.2l-2.4 3.4h2.2L10.4 21"></path>
        {% elseif name == 'sunrise' or name == 'sunset' %}
            <path d="M4 17h16M7 17a5 5 0 0 1 10 0M12 4.5v3M6.2 8.2l1.8 1.8M17.8 8.2l-1.8 1.8"></path>
        {% elseif name == 'wind' %}
            <path d="M4 8h9.5a2.2 2.2 0 1 0-2.1-2.8M4 12h13a2.2 2.2 0 1 1-2.1 2.8M4 16h7"></path>
        {% elseif name == 'pressure' %}
            <path d="M5 16a7 7 0 0 1 14 0M12 16l3.2-4.2"></path>
            <circle cx="12" cy="16" r="1.1"></circle>
        {% elseif name == 'humidity' %}
            <path d="M12 3.5s5.5 6 5.5 9.4a5.5 5.5 0 0 1-11 0C6.5 9.5 12 3.5 12 3.5z"></path>
        {% else %}
            <path d="M7 18h10.2a3.8 3.8 0 0 0 .4-7.6 5 5 0 0 0-9.6-1.3A3.4 3.4 0 0 0 7 18z"></path>
        {% endif %}
    </svg>
{% endmacro %}
